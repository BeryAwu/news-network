# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3000
APP_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/nnms?schema=public"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Cloudinary (required for all managed images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AI provider (choose and implement a provider adapter; keep keys server-side)
AI_PROVIDER=""
AI_MODEL=""
AI_API_KEY=""

# Optional auth provider values, if selected by implementation
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional observability
LOG_LEVEL=info
