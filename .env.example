ADMIN_BASE_URL=http://localhost:3000
SESSION_SECRET=
DATABASE_URL=postgresql://postgres:password@localhost:5432/news_network?schema=public

# Optional background jobs. Inline publishing is used when unset; future schedules need the worker.
REDIS_URL=

# Mandatory for all managed image assets. Keep API secret server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supported providers: openrouter, openai, or openai-compatible. Keys stay server-side.
# OpenRouter defaults to model qwen/qwen3-235b-a22b-2507 if AI_MODEL is blank.
# Use qwen/qwen3-32b for a lower-cost option; set AI_API_KEY to your OpenRouter key.
AI_PROVIDER=openrouter
AI_MODEL=qwen/qwen3-235b-a22b-2507
AI_API_KEY=
AI_BASE_URL=
# Development-only deterministic adapter; ignored in production.
AI_TEST_ADAPTER=false

# Optional first owner seed inputs; never commit production values.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Newsroom Owner
